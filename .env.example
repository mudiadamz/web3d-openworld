# Defaults for the sandbox, read by server.js at startup.
#
#   cp .env.example .env   &&   npm start
#
# Every one of these is optional: anything left unset keeps the value written
# into index.html. Real environment variables win over this file, so a one-off
# run needs no edit at all:
#
#   DEER=90 CAMPS=4 npm start
#
# Out-of-range numbers are clamped and unparseable ones ignored, both with a
# warning. The ranges are the same as the panel's sliders.

# ---- world ----
# SEED=20260906              # any integer; the same seed rebuilds the same island
# QUALITY=high               # low | medium | high — rendering cost only
# MAP=1600                   # metres across; 800–6400. Counts do not scale with
#                            # it, so raise TREES, GRASS and the rest alongside

# ---- time and sky ----
# TIME=7.5                   # starting hour, 0-24. The clock always runs.
# DAY_LENGTH=3600            # real seconds for a full day, 60-7200
# YEAR_LENGTH=24             # simulated days in a year, 4-200. Winter forage is
#                            # about a third of high summer, so this sets how hard
#                            # the band is pressed and how often.
# EXPOSURE=0.5               # 0.1-1.2

# ---- wind ----
# WIND=0.35                  # 0-1
# WIND_DIR=135               # degrees the wind blows toward, 0 = north
# GUST=0.5                   # 0 = steady breeze, 1 = arrives in waves

# ---- camera ----
# VIEW=fly                   # fly | walk | orbit | follow
# FOV=58                     # degrees, 30-110

# ---- water ----
# STREAMS=5                  # creeks, 0-12. They carve the terrain they run through.
# WAVES=1                    # swell and ripple scale, 0-2

# ---- models ----
# Real glTF geometry for the wildlife, fetched from the three.js example models.
# off   built-in shapes only, nothing downloaded
# birds three morph-animated birds — a straight win, nothing is lost
# all   the herds too. A single-mesh animal cannot lower its head to graze, so
#       this buys a silhouette and spends some behaviour. See the README.
# MODELS=birds

# ---- rendering and sound ----
# NIGHT_SKIP=true            # run the night through once everyone is asleep
# NIGHT_FROM=-0.02           # where the night window opens, in sun height: 0 is
#                            # the horizon, -0.9 is the far side of midnight.
#                            # Nearer 0 starts sooner; further down leaves you
#                            # more dusk to sit through
# NIGHT_DEEP=-0.25           # and where it stops waiting for stragglers and runs
#                            # whatever anybody is still doing. Never treated as
#                            # above NIGHT_FROM, whatever you set
# NIGHT_SKIP_RATE=6          # 1-60, how much of each frame is spent running the
#                            # night through. 6 is about a second of real time;
#                            # higher finishes sooner and makes those frames
#                            # chuggier. It used to be a multiplier on the clock,
#                            # which could not go above 15 without the books
#                            # outrunning the sleeping.
# SHADOWS=true               # true/false, yes/no, on/off, 1/0
# TERRAIN_SHADOW=false       # hills shading each other. Costs a second pass
                             # over the whole terrain and speckles at a low
                             # sun, which is why it is off.
# WATER=true
# SOUND=true
# VOLUME=0.55                # 0-1

# ---- populations ----
# Naming a QUALITY loads that preset's populations. Anything set here wins
# over the preset, so QUALITY=low with DEER=100 does what it says.
# GRASS=2000                 # blades per 24m tile, 0-4000
# TREES=1000                 # 0-3000
# ROCKS=260                  # 0-1200
# FLOWERS=150                # blooms per 24m tile, 0-600
# FRUIT=5                    # fruit per broadleaf tree, 0-12
# BISON=9                    # 0-60
# DEER=22                    # 0-120
# RABBITS=44                 # 0-200
# BOARS=16                   # 0-120. They eat the fruit the band was going to
# TIGERS=2                   # 0-40. Predators: they hunt the herds, and people
# BIRDS=44                   # 0-200
# BUTTERFLIES=70             # 0-400
# CAMPS=2                    # 0-40, but how many actually land depends on the
#                            # map: sites need 260m between them, so about 7 fit
#                            # at MAP=1600, 22 at 3200 and all 40 by 4800. The
#                            # rest are skipped without complaint.
# PEOPLE=16                  # how many the band STARTS with, 0-800 — and also
#                            # the ceiling on growth: room for people is fixed at
#                            # four times this when the world is built, and an
#                            # InstancedMesh cannot be resized afterwards.
# FERTILITY=1                # multiplier on the birth rate, 0-3. Zero is a band
#                            # that will not replace itself.

# ---- the server itself ----
# The chronicle: every hunt, every hungry night and a row a day, in SQLite.
# Delete the file to start the record over; the worlds themselves are rebuilt
# from their seed, so nothing is lost by doing so.
# CHRONICLE_DB=chronicle.db
# PORT=8080
# HOST=127.0.0.1             # 0.0.0.0 to reach it from another machine
