# humans-threejs lists three as a peer; the page loads three from its CDN and
# the body data imports nothing, so a second copy in node_modules is dead weight.
omit=peer

# humans-threejs asks for @types/three ^0.180 as an optional peer, while this
# project pins ^0.169 to match the three it builds against. Only type
# definitions differ, and nothing at runtime, so an install should not stop on it.
legacy-peer-deps=true
