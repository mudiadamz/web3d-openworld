# The chronicle is a record of runs, not source. Delete it to start over — the
# worlds themselves are rebuilt from their seed, so nothing is lost.
chronicle.db
chronicle.db-wal
chronicle.db-shm

# Your own settings; .env.example is the one that is checked in.
.env

# three.js for the boot check; fetched, not source
vendor/

# Written by deploy\service.ps1 — machine-specific paths and the service's own log.
deploy/run.cmd
logs/

# The one dependency, installed from GitHub by `npm install`.
node_modules/

# Built from src/ by `npm run build` (tsc). The page loads this, but it is
# output, not source — rebuild it with `npm run build`.
dist/

# The Node side, built from the .ts beside each by `npm run build` (see
# tsconfig.node.json). They sit at the root rather than in a folder so that
# `node server.js` — which is how the Windows service runs — keeps working.
# Output, not source: edit the .ts.
/config.js
/db.js
/reset.js
/server.js
/dev.js
/config.js.map
/db.js.map
/reset.js.map
/server.js.map
/dev.js.map
